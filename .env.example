# Google Sheets Apps Script URLs (deploy from Google Sheets → Extensions → Apps Script)
# Leave empty to use local JSON data

# Stock/Inventory sheet
GOOGLE_STOCK_URL=

# Business sheet (MENU, ORDER, Stats, Finance)
GOOGLE_BUSINESS_URL=

# Admin credentials
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Session secret (random 32-byte hex string)
SESSION_SECRET=

# Apps Script webhook shared secret (optional). When set, every request to the
# Apps Script carries ?token=<APPS_SCRIPT_TOKEN>; add a matching check in your
# Apps Script doGet/doPost so a leaked Apps Script URL alone is not enough.
APPS_SCRIPT_TOKEN=

# Public shop config
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_SHOP_NAME=
NEXT_PUBLIC_SHOP_DESCRIPTION=
