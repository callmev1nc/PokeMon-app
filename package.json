{
  "name": "pokemon-card-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build-data": "npx tsx scripts/build-data.ts",
    "dev": "npm run build-data && next dev",
    "build": "npm run build-data && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "validate-cards": "npx tsx scripts/validate-cards.ts && node -e \"require('fs').copyFileSync('validation-report.json','public/data/validation-report.json')\"",
    "validate-cards:sheet": "npx tsx scripts/validate-cards.ts --sheet-url=$GOOGLE_BUSINESS_URL && node -e \"require('fs').copyFileSync('validation-report.json','public/data/validation-report.json')\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bcryptjs": "^3.0.3",
    "eslint": "^10.2.0",
    "html2pdf.js": "^0.14.0",
    "next": "^16.2.3",
    "postcss": "^8.5.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.9"
  }
}
